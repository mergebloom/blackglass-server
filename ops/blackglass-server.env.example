# Copy to /etc/blackglass-server/server.env, owner root, mode 0600.
SELFHOST_BIND_HOST=127.0.0.1
SELFHOST_CONTROL_PORT=3000
SELFHOST_DATA_PORT=3003
SELFHOST_DATA_HOST=sync-data.example.com
# Optional read-only admin console. Set all three or none. Generate a separate
# 64-character lowercase hexadecimal token with: openssl rand -hex 32
# Store only its hash: printf %s "$TOKEN" | sha256sum
# Keep loopback. A private/TLS reverse proxy must rewrite upstream Host to the
# configured loopback authority, for example 127.0.0.1:3010.
# SELFHOST_ADMIN_BIND_HOST=127.0.0.1
# SELFHOST_ADMIN_PORT=3010
# SELFHOST_ADMIN_TOKEN_HASH=REPLACE_WITH_64_LOWERCASE_SHA256_HEX
SELFHOST_DATABASE=/var/lib/blackglass-server/server.sqlite
SELFHOST_STAGING_DIR=/var/lib/blackglass-server/uploads
SELFHOST_EMAIL=owner@example.com
SELFHOST_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$REPLACE_WITH_HASH_PASSWORD_OUTPUT
SELFHOST_NAME=Vault owner
SELFHOST_ALLOWED_ORIGINS=app://obsidian.md
# Exact loopback Caddy peer; Caddyfile.example overwrites X-Forwarded-For.
SELFHOST_TRUSTED_PROXY=127.0.0.1
SELFHOST_PER_FILE_MAX=209715200
# All retained ciphertext revisions across all vaults; default is 1 TiB.
SELFHOST_STORAGE_QUOTA_BYTES=1099511627776
SELFHOST_MAX_CONCURRENT_UPLOADS=4
SELFHOST_UPLOAD_IDLE_TIMEOUT_SECONDS=300
SELFHOST_MAX_WS_CONNECTIONS=16
SELFHOST_SESSION_TTL_SECONDS=2592000
SELFHOST_LOG_FORMAT=json
RUST_LOG=info
