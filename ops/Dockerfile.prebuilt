# syntax=docker/dockerfile:1.24.0@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

# Assemble the published OCI image from a native, already-tested release binary.
# The release workflow supplies a minimal per-architecture build context containing
# the binary, its license notices, and an empty persistent-state directory.
FROM scratch

ARG SOURCE_REVISION
ARG SOURCE_URL
ARG TARGETARCH
ARG VERSION

LABEL org.opencontainers.image.title="Blackglass Server" \
      org.opencontainers.image.description="Lean self-hosted encrypted-vault synchronization service" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="$SOURCE_URL" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.architecture="$TARGETARCH"

COPY --chmod=0555 blackglass-server /usr/local/bin/blackglass-server
COPY LICENSE /licenses/LICENSE
COPY THIRD_PARTY_NOTICES.md /licenses/THIRD_PARTY_NOTICES.md
COPY --chown=65532:65532 state/ /var/lib/blackglass-server/

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    SELFHOST_BIND_HOST=127.0.0.1 \
    SELFHOST_DATABASE=/var/lib/blackglass-server/server.sqlite \
    SELFHOST_STAGING_DIR=/var/lib/blackglass-server/uploads

EXPOSE 3000 3003
VOLUME ["/var/lib/blackglass-server"]
USER 65532:65532
WORKDIR /var/lib/blackglass-server
ENTRYPOINT ["/usr/local/bin/blackglass-server"]
CMD ["serve"]
